* A pin that toggles once every 10 ms forever (a 50 Hz square wave).
VE_d_per pin_d_per 0 PULSE(0 3.6 10m 1u 1u 10m 20m)
XP_d_per pin_d_per g_d_per PUMPX_HOTSLL params: R35=554.4 R34=101k C22=126.5n C23=0.742u IL=0.07u
CGQ_d_per g_d_per 0 630p
RGQ_d_per g_d_per 0 26meg

.tran 2u 470m 0 5u

.meas tran a_cold_gate_min_v MIN v(g_a_cold) FROM=0.18 TO=0.2
.meas tran a_cold_coil_current_a AVG i(VCOIL_a_cold) FROM=0.18 TO=0.2
.meas tran a_room_gate_min_v MIN v(g_a_room) FROM=0.18 TO=0.2
.meas tran a_room_coil_current_a AVG i(VCOIL_a_room) FROM=0.18 TO=0.2
.meas tran a_hot_gate_min_v MIN v(g_a_hot) FROM=0.18 TO=0.2
.meas tran a_hot_coil_current_a AVG i(VCOIL_a_hot) FROM=0.18 TO=0.2
.meas tran a_hotx_gate_min_v MIN v(g_a_hotx) FROM=0.18 TO=0.2
.meas tran a_hotx_coil_current_a AVG i(VCOIL_a_hotx) FROM=0.18 TO=0.2
.meas tran a_cold_gate_peak_v MAX v(g_a_cold) FROM=0 TO=0.2
.meas tran a_cold_rail_gate_min_v MIN v(g_a_cold_rail) FROM=0.18 TO=0.2
.meas tran a_cold_rail_coil_current_a AVG i(VCOIL_a_cold_rail) FROM=0.18 TO=0.2
.meas tran a_cold_nopar_gate_min_v MIN v(g_a_cold_nopar) FROM=0.18 TO=0.2
.meas tran b_room_pickup_s TRIG v(sq_b_room) VAL=1.5 RISE=1 TARG v(g_b_room) VAL=1.45 RISE=1
.meas tran b_room_gate_at_30ms_v FIND v(g_b_room) AT=0.04
.meas tran b_hot_pickup_s TRIG v(sq_b_hot) VAL=1.5 RISE=1 TARG v(g_b_hot) VAL=1.315 RISE=1
.meas tran b_hot_gate_at_30ms_v FIND v(g_b_hot) AT=0.04
.meas tran b_hotx_pickup_s TRIG v(sq_b_hotx) VAL=1.5 RISE=1 TARG v(g_b_hotx) VAL=1.315 RISE=1
.meas tran b_hotx_gate_at_30ms_v FIND v(g_b_hotx) AT=0.04
.meas tran c_low_release_s TRIG v(env) VAL=0.5 TD=0.199 FALL=1 TARG v(g_c_low) VAL=0.515 TD=0.199 FALL=1
.meas tran c_high_release_s TRIG v(env) VAL=0.5 TD=0.199 FALL=1 TARG v(g_c_high) VAL=0.515 TD=0.199 FALL=1
.meas tran c_ll_low_release_s TRIG v(env) VAL=0.5 TD=0.199 FALL=1 TARG v(g_c_ll_low) VAL=0.515 TD=0.199 FALL=1
.meas tran c_ll_high_release_s TRIG v(env) VAL=0.5 TD=0.199 FALL=1 TARG v(g_c_ll_high) VAL=0.515 TD=0.199 FALL=1
.meas tran c_ll_low_coil_off_s TRIG v(env) VAL=0.5 TD=0.199 FALL=1 TARG i(VCOIL_c_ll_low) VAL=0.0021 TD=0.199 FALL=1
.meas tran c_ll_low_coil_current_a AVG i(VCOIL_c_ll_low) FROM=0.18 TO=0.2
.meas tran d_e1_peak_v MAX v(g_d_e1) FROM=0 TO=0.06
.meas tran d_e2_peak_v MAX v(g_d_e2) FROM=0 TO=0.06
.meas tran d_e3_peak_v MAX v(g_d_e3) FROM=0 TO=0.06
.meas tran d_e4_peak_v MAX v(g_d_e4) FROM=0 TO=0.06
.meas tran d_e5_peak_v MAX v(g_d_e5) FROM=0 TO=0.06
.meas tran d_e6_peak_v MAX v(g_d_e6) FROM=0 TO=0.06
.meas tran d_e8_peak_v MAX v(g_d_e8) FROM=0 TO=0.06
.meas tran d_e10_peak_v MAX v(g_d_e10) FROM=0 TO=0.06
.meas tran d_e1_final_v AVG v(g_d_e1) FROM=0.45 TO=0.46
.meas tran a_cold_parasitic_delta_v PARAM='a_cold_nopar_gate_min_v-a_cold_gate_min_v'
.meas tran c_low_hang_to_off_s PARAM='c_low_release_s+0.02'
.meas tran c_high_hang_to_off_s PARAM='c_high_release_s+0.02'
.meas tran c_ll_low_hang_to_off_s PARAM='c_ll_low_release_s+0.02'
.meas tran c_ll_high_hang_to_off_s PARAM='c_ll_high_release_s+0.02'
.meas tran d_e1_margin_to_vt_lo_v PARAM='0.515-d_e1_peak_v'
.meas tran d_periodic_peak_v MAX v(g_d_per) FROM=0 TO=0.47

.end
