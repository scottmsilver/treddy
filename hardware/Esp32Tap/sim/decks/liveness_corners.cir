V33 v33 0 3.3
VENV env 0 PULSE(1 0 200m 1u 1u 10 20)

* ===== A: minimum steady gate voltage (weakest pump), with the coil loop =====
* --- a_cold: diode COLD, driver 0.4/2.6 V, f=950 Hz duty=0.4, R34=99000 R35=565.6 C22=70.5n C23=0.557u
VSQ_a_cold sq_a_cold 0 PULSE(0.4 2.6 10m 1u 1u 0.000421053 0.00105263)
BPIN_a_cold pin_a_cold 0 V=v(sq_a_cold)*v(env)+0.4*(1-v(env))
XP_a_cold pin_a_cold g_a_cold PUMPX_COLD params: R35=565.6 R34=99000 C22=7.05e-08 C23=5.57e-07 IL=3e-09
CGQ_a_cold g_a_cold 0 630p
RGQ_a_cold g_a_cold 0 26meg
V5_a_cold v5_a_cold 0 5
L_a_cold v5_a_cold lr_a_cold 0.5
R_a_cold lr_a_cold ls_a_cold 237
VCOIL_a_cold ls_a_cold lc_a_cold 0
XCLAMP_a_cold v5_a_cold lc_a_cold ESP_BIDI_TVS params: VCLAMP=6.67 RDYN=0.094
SQ1_a_cold lc_a_cold lq_a_cold v33 0 ESP_SWITCH
XQ3_a_cold lq_a_cold g_a_cold ESP_Q3 params: VT=1.585

